# =============================================================================
# NEXUS EXCHANGE ERP — environment template (PART 43)
# =============================================================================
# Copy to .env and fill in real values. NEVER commit .env (it is git-ignored).
# The application refuses to start when a required secret is empty.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
APP_ENV=development                 # development | test | production
APP_NAME=NEXUS EXCHANGE ERP
APP_VERSION=0.0.0-phase0
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                     # json (production) | console (local)
TZ=UTC                              # the server always stores UTC

# --- Database ----------------------------------------------------------------
# Application runtime role: DML only, no DELETE on ledgers (see docs/database/SCHEMA.md §8)
DATABASE_URL=postgresql+asyncpg://nexus_app:change-me@postgres:5432/nexus_exchange
# Migration role: owns the schema (used only by alembic and seeds)
DATABASE_MIGRATION_URL=postgresql+asyncpg://nexus_owner:change-me@postgres:5432/nexus_exchange
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

# --- PostgreSQL container bootstrap (compose only) ---------------------------
POSTGRES_DB=nexus_exchange
POSTGRES_USER=nexus_owner
POSTGRES_PASSWORD=change-me
POSTGRES_TIMEZONE=UTC

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://:change-me@redis:6379/0
REDIS_REQUIRED_PASSWORD=change-me
CELERY_BROKER_URL=redis://:change-me@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change-me@redis:6379/2

# --- Authentication ----------------------------------------------------------
# Generate with: openssl rand -hex 32   (32 bytes = 64 hex chars, required)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ALGORITHM=HS256                 # HS256 | RS256 (RS256 requires JWT_PRIVATE_KEY_PATH)
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536            # KiB (64 MiB)
ARGON2_PARALLELISM=4
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- HTTP / security ---------------------------------------------------------
# Comma-separated allowlist. NEVER use "*" together with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
TRUSTED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_5MIN=10
RATE_LIMIT_WRITE_PER_MIN=120
RATE_LIMIT_READ_PER_MIN=600
SECURE_HEADERS_ENABLED=true
FORCE_HTTPS=false                   # true in production (nginx terminates TLS)

# --- Domain policy -----------------------------------------------------------
BASE_CURRENCY_CODE=AFN
RATE_TOLERANCE_BPS=50               # accepted deviation from the quoted rate (0.50%)
BUSINESS_DATE_SKEW_MINUTES=120      # offline business-date skew before an event is flagged
OFFLINE_MAX_MINUTES_DEFAULT=480     # default offline window when granting an allocation
NUMBERING_PREFIX_EXCHANGE=NX
NUMBERING_PREFIX_TRANSFER=TR
NUMBERING_WIDTH=6
IDEMPOTENCY_RETENTION_DAYS=30

# --- Storage / backups -------------------------------------------------------
STORAGE_PATH=/data/storage
BACKUP_ENABLED=true
BACKUP_SCHEDULE_CRON=0 2 * * *      # daily 02:00 server time
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_RECIPIENT=        # age/GPG recipient; the private key stays offline
BACKUP_VERIFY_AFTER_CREATE=true

# --- Worker ------------------------------------------------------------------
CELERY_TASK_ALWAYS_EAGER=false      # true only in tests
CHANGE_LOG_RETENTION_DAYS=180
RECONCILIATION_CRON=0 3 * * *       # nightly integrity + cache drift check

# --- Development seed (development only; refuses to run when APP_ENV=production)
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=                 # leave empty to skip seeding an admin account
DEV_ADMIN_FULL_NAME=System Administrator

# --- Observability (optional) ------------------------------------------------
SENTRY_DSN=
METRICS_ENABLED=false
